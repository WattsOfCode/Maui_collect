<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIREST.DataPage"
             Title="DataEntryPage">

    <ScrollView>

        <VerticalStackLayout Padding="30" Spacing="20">
            
            <Label Text="John Deardorff" Style="{StaticResource Headline}" />
            <Label Text="Please provide the following information:" />



            <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                  ColumnDefinitions="Auto,*" 
                  RowSpacing="15" ColumnSpacing="10">

                <Label 
                    Text="Item ID"
                    Grid.Row="0" Grid.Column="0" 
                    VerticalOptions="Center"/>
                <Entry x:Name="ItemIdEntry" 
                       Grid.Row="0" Grid.Column="1" 
                       Placeholder="Enter ID" />
                <Label 
                    Text="Item Name" 
                    Grid.Row="1" Grid.Column="0" 
                    VerticalOptions="Center"/>

                <Entry 
                    x:Name="ItemNameEntry" 
                    Grid.Row="1" Grid.Column="1" 
                    Placeholder="Enter Name" />

                <Label 
                    Text="Item Description" 
                    Grid.Row="2" Grid.Column="0" 
                    VerticalOptions="Center"/>

                <Entry 
                    x:Name="ItemDescriptionEntry" 
                    Grid.Row="2" Grid.Column="1" 
                    Placeholder="Enter Description" />

                <Button 
                    x:Name="SaveBtn" Text="Save" 
                    Grid.Row="3" Grid.ColumnSpan="2" 
                    Clicked="OnSaveClicked" 
                    Margin="0,10,0,0" />

            </Grid>
            <BoxView HeightRequest="1" Color="Gray" />
            <Label 
                Text="Stored Items: " 
                FontAttributes="Bold" />

            <CollectionView x:Name="ItemsListView" HeightRequest="400" BackgroundColor="LightGray">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Stroke="Black" Margin="5" Padding="10" BackgroundColor="White">
                            <VerticalStackLayout>
                                
                                <Label 
                                    Text="{Binding ItemName}"   TextColor="Red" 
                                    FontAttributes="Bold"  FontSize="18" />
                                <Label 
                                    Text="{Binding ItemDescription}"   
                                    TextColor="Blue" FontSize="14" />
                                
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>