<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUIREST.MainPage">
    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label Text="John Deardorff" Style="{StaticResource Headline}" 
                   SemanticProperties.HeadingLevel="Level1" />

            <Entry x:Name="txtUserId" Placeholder="Enter User ID" />
            <Entry x:Name="txtPassword" Placeholder="Enter Password" />

            <Button Text="Login" Clicked="OnLoginClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>