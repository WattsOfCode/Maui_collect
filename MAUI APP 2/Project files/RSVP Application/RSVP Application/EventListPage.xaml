<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Application.EventListPage"
             BackgroundColor="#F0EAD6"
             Title="Events List Page">
    <!-- 
        Application page: Events List page
        Maker: John Deardorff
        Date: 02/08/2026
        Purpose: provide the user with a list of events they have 
        created or are attending.
    -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">
    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="20">
        <Label Text="RSVP Dashboard" Style="{StaticResource Headline}" />
        <Button Text="Log Out" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="Black" />
    </HorizontalStackLayout>

    <Picker Grid.Row="1" x:Name="FilterPicker" Title="Filter Events" SelectedIndexChanged="OnFilterChanged">
        <Picker.Items>
            <x:String>All Events</x:String>
            <x:String>Events I'm Hosting</x:String>
        </Picker.Items>
    </Picker>

    <CollectionView Grid.Row="2" x:Name="EventListView" SelectionMode="Single" SelectionChanged="OnEventSelected">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,5" Padding="15" Stroke="LightGray" StrokeShape="RoundRectangle 10" BackgroundColor="#CCFFFFFF">
                    <HorizontalStackLayout Spacing="15">
                        <VerticalStackLayout BackgroundColor="DarkSlateGray" Padding="10" WidthRequest="60">
                            <Label Text="{Binding Date, StringFormat='{0:MMM}'}" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Label Text="{Binding Date, StringFormat='{0:dd}'}" TextColor="White" HorizontalOptions="Center" FontSize="20"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18"/>
                            <Label Text="{Binding Address}" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

    <Button Grid.Row="3" Text="+ Create New Event" Clicked="OnCreateEvent_Clicked" />
    </Grid>
</ContentPage>