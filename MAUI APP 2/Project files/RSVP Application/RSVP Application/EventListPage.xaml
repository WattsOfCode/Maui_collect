<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Application.EventListPage"
             Title="Events List Page">
    <!-- 
        Application page: Events List page
        Maker: John Deardorff
        Date: 02/08/2026
        Purpose: provide the user with a list of events they have 
        created or are attending.
    -->
    <Grid RowDefinitions="Auto, *, Auto">

        <VerticalStackLayout>
            <Label Text="RSVP Dashboard" Style="{StaticResource Headline}" />
            <Label Text="Find your event" Style="{StaticResource SubHeadline}" Margin="0,0,0,10" />
        </VerticalStackLayout>

        <CollectionView 
            Grid.Row="0" 
            x:Name="EventListView" 
            SelectionMode="Single" 
            SelectionChanged="OnEventSelected" >
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,5" Padding="15" Stroke="LightGray" StrokeShape="RoundRectangle 10">
                        <HorizontalStackLayout Spacing="15">
                            <VerticalStackLayout>
                                <Label 
                                    Text="{Binding EventDate, StringFormat='{0:MMM}'}" 
                                    HorizontalOptions="Center" 
                                    TextColor="White" 
                                    FontAttributes="Bold"/>
                                <Label 
                                    Text="{Binding EventDate, StringFormat='{0:dd}'}" 
                                    HorizontalOptions="Center" 
                                    TextColor="White" 
                                    FontSize="Title"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout VerticalOptions="Center">
                                <Label 
                                    Text="{Binding Name}" 
                                    FontAttributes="Bold" 
                                    FontSize="18"/>
                                <Label 
                                    Text="{Binding Location}" 
                                    TextColor="Gray"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        <Button Grid.Row="2"
                Text="+ Create New Event"
                Clicked="OnCreateEvent_Clicked"
                Margin="0,10,0,0"
                Style="{StaticResource FilledButton}" />
    </Grid>
</ContentPage>