<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Application.EventPage"
             BackgroundColor="#F0EAD6"
             Title="EventPage">
    <!--  
        Application page: EventDetails page
        Maker: John Deardorff
        Date: 02/07/2026
        Purpose: This page will display the details of a selected 
        event including the event name, date, time, location, 
        description, and an option to RSVP.
    
        this will be editable only in the event that the user is 
    `   the creator of the event, otherwise it will be read only.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label 
                Text="RSVP"
                Style="{StaticResource Headline}" 
                HorizontalOptions="Center" />
            <Label
                Text="Event Details"
                Style="{StaticResource SubHeadline}" 
                HorizontalOptions="Center" 
                Margin="0,0,0,10" />

            <!-- Event information section -->

            <Label 
                x:Name="EventTitle" 
                Text="Event" FontAttributes="Bold" 
                />
            <Entry 
                x:Name="EventNameEntry" 
                Placeholder="Birthday Party" 
                />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0">

                    <Label 
                        Text="Date" 
                        FontAttributes="Bold" 
                        />
                    <DatePicker 
                        x:Name="EventDatePicker" 
                        />

                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">

                    <Label 
                        Text="Time" 
                        FontAttributes="Bold" 
                        />
                    <TimePicker 
                        x:Name="EventTimePicker" 
                        />

                </VerticalStackLayout>
            </Grid>

            <Label
                Text="Location" 
                FontAttributes="Bold" 
                /> 
            <Entry
                x:Name="EventLocationEntry" 
                Placeholder="100 Main St, City, State" 
                />

            <Label
                Text="Description"
                FontAttributes="Bold"
                />
            <Editor
                x:Name="EventDescriptionEditor"
                Placeholder="Enter event description here..."
                AutoSize="TextChanges"
                HeightRequest="100"
                />

            <BoxView
                HeightRequest="1"
                Color="LightGrey"
                Margin="0,10"
                />

            <VerticalStackLayout x:Name="GuestSection" Spacing="10">
                <Label 
                    Text="Will you be attending?" 
                    HorizontalOptions="Center" 
                    />
                <Button 
                    Text="I'm Attending!" 
                    Clicked="OnRSVP_Clicked" 
                    BackgroundColor="Green" 
                    />
                <Button 
                    Text="Maybe next time" 
                    Clicked="OnDecline_Clicked" 
                    BackgroundColor="Red" 
                    />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="CreatorSection" IsVisible="False" Spacing="10">
                <Button 
                    Text="Save Changes" 
                    Clicked="OnSaveChanges_Clicked" 
                    />
                <Button 
                    Text="Delete Event" 
                    Clicked="OnDeleteEvent_Clicked" 
                    BackgroundColor="DarkRed" 
                    /> 

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>