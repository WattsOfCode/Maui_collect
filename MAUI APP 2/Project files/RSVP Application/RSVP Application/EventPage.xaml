<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Application.EventPage"
             Title="EventPage">
    <!--  
        Application page: EventDetails page
        Maker: John Deardorff
        Date: 02/07/2026
        Purpose: This page will display the details of a selected 
        event including the event name, date, time, location, 
        description, and an option to RSVP.
    
        this will be editable only in the event that the user is 
    `   the creator of the event, otherwise it will be read only.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label 
                Text="RSVP"
                Style="{StaticResource Headline}" 
                HorizontalOptions="Center" />
            <Label
                Text="Event Details"
                Style="{StaticResource SubHeadline}" 
                HorizontalOptions="Center" 
                Margin="0,0,0,10" />
            <Label
                x:Name="EventNameEntry"
                />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>