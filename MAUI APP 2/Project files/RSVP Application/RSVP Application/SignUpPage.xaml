<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RSVP_Application.SignUpPage"
             BackgroundColor="#F0EAD6"
             Title="Create Account">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <Label Text="Join RSVP" TextColor="Black" Style="{StaticResource Headline}" HorizontalOptions="Center"  />

            <Frame BackgroundColor="#CCFFFFFF" CornerRadius="15" HasShadow="False" Padding="20" >
                <VerticalStackLayout Spacing="15" >
                    <Entry x:Name="NewName" Placeholder="Full Name" TextColor="Black"/>
                    <Entry x:Name="NewUserName" Placeholder="Username" TextColor="Black"/>
                    <Entry x:Name="NewEmail" Placeholder="Email Address" Keyboard="Email" TextColor="Black"/>
                    <Entry x:Name="NewPhone" Placeholder="Phone Number" Keyboard="Telephone" TextColor="Black"/>
                    <Entry x:Name="NewPassword" Placeholder="Password" IsPassword="True" TextColor="Black"/>
                    <Entry x:Name="ConfirmPassword" Placeholder="Confirm Password" IsPassword="True" TextColor="Black"/>
                </VerticalStackLayout>
            </Frame>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Register" 
                Clicked="OnRegisterClicked" WidthRequest="140" TextColor="Black"/>

                <Button Text="Cancel" Clicked="OnCancelClicked" 
                        WidthRequest="140" BackgroundColor="Transparent" TextColor="Red" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>